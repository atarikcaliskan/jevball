{
  "name": "jevball",
  "version": "1.0.0",
  "private": true,
  "author": "atarikcaliskan (https://github.com/atarikcaliskan)",
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://jevball.online",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atarikcaliskan/jevball.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:jev": "node --env-file=.env scripts/verify-jev.mjs",
    "match": "node scripts/headless-match.mjs",
    "format": "prettier --write src server tests scripts vite.config.js index.html package.json README.md",
    "deploy": "npm run build && wrangler deploy",
    "dev:worker": "npm run build && wrangler dev"
  },
  "dependencies": {
    "lucide": "^0.577.0",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "prettier": "^3.9.7",
    "vite": "^8.0.0",
    "wrangler": "^4.135.0"
  }
}
