# Your own TypeSafe AI key. Used server-side by npm run dev / preview.
# Without a key the match still runs: all 22 players use the local policy.
TYPESAFE_API_KEY=your_key_here
# USD per million tokens; TypeSafe launch pricing, September 2026.
JEV_INPUT_PRICE=0.042
JEV_OUTPUT_PRICE=0

# Optional server binding overrides (defaults to localhost).
# JEV_HOST=localhost
# JEV_ALLOWED_HOSTS=your-hostname.example
